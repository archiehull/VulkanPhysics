# --- ORBITING ANCHOR ---
Object OrbitAnchor
    Type Sphere
    Params 1.2
    Texture tex_ramp
    Position 0.0 55.0 0.0
    RenderProps 1 true true true 3
    # Anchor must be static so it doesn't fall, allowing orbit to guide it
    PhysicsProps false false true 
    Orbit true 12.0 0.8 0.0
    # format: SpringProps <RestingLength> <Stiffness> <Damping>
    SpringProps 8.0 80.0 4.0
    SpringConnect SpringChild1
    SpringConnect SpringChild2
    SpringConnect SpringChild3
    SpringConnect SpringChild4
    SpringConnect SpringChild5
EndObject